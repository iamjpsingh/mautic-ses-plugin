{
    "name": "iamjpsingh/mautic-ses-plugin",
    "description": "Bounce, complaint, and delivery tracking for Amazon SES via SNS webhooks for Mautic 6+",
    "type": "mautic-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "mautic",
        "plugin",
        "amazon-ses",
        "email",
        "bounce",
        "sns-webhook"
    ],
    "authors": [
        {
            "name": "JP Singh",
            "homepage": "https://github.com/iamjpsingh"
        }
    ],
    "homepage": "https://github.com/iamjpsingh/mautic-ses-plugin",
    "support": {
        "issues": "https://github.com/iamjpsingh/mautic-ses-plugin/issues",
        "source": "https://github.com/iamjpsingh/mautic-ses-plugin"
    },
    "extra": {
        "install-directory-name": "MauticAmazonSesBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticAmazonSesBundle\\": ""
        }
    },
    "require": {
        "php": ">=8.2",
        "mautic/core-lib": "^6.0 || ^7.0",
        "symfony/amazon-mailer": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "symfony/http-client": "For better HTTP handling when confirming SNS subscriptions"
    },
    "provide": {
        "mautic/ses-transport": "1.0.0"
    },
    "minimum-stability": "dev"
}
